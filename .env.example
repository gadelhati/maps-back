# ==========================================
# ENVIRONMENT VARIABLES TEMPLATE
# ==========================================
# Copy this file to .env and fill in your actual values
# This file can be safely committed to version control

# ==========================================
# JWT CONFIGURATION
# ==========================================
JWT_SECRET=your_jwt_secret_here_minimum_512_bits
JWT_ISSUER=your_app_name
JWT_AUDIENCE=https://your-audience-url
JWT_EXPIRATION=14400000
JWT_REFRESH=86400000

# ==========================================
# EMAIL CONFIGURATION
# ==========================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here

# ==========================================
# RECAPTCHA CONFIGURATION
# ==========================================
RECAPTCHA_SITE=your_recaptcha_site_key
RECAPTCHA_SECRET=your_recaptcha_secret_key
RECAPTCHA_URL=https://www.google.com/recaptcha/api/siteverify

# ==========================================
# DATABASE CONFIGURATION - PRODUCTION
# ==========================================
DATABASE_URL=jdbc:postgresql://your-host:5432/your-database
DATABASE_USERNAME=your_username
DATABASE_PASSWORD=your_password
DATABASE_DRIVER=org.postgresql.Driver
DATABASE_PLATFORM=postgres

# ==========================================
# RATE LIMITING CONFIGURATION
# ==========================================
RATE_LIMIT_REQUESTS=50
RATE_LIMIT_CLEANUP_INTERVAL=15
RATE_LIMIT_BURST_MULTIPLIER=2

# ==========================================
# SECURITY CONFIGURATION
# ==========================================
CSRF_ENABLED=true
SESSION_TIMEOUT=3600